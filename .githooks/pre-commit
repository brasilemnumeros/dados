#!/bin/sh
# Roda os verificadores locais antes de commitar.
#
# Instalação (uma vez por clone):
#   git config core.hooksPath .githooks
#
# O que pega: contrato quebrado em indicadores/*.json (o caso do IPCA, que voltou
# a escrever o formato antigo sem ninguém notar) e regressão nos testes Python.
set -e

cd "$(git rev-parse --show-toplevel)"

# Só vale a pena quando o commit toca dado, validador, testes ou dependências.
if ! git diff --cached --name-only | grep -qE '^(indicadores/|scripts/|tests/|pyproject\.toml|uv\.lock)'; then
  exit 0
fi

test -f scripts/validar.py || exit 0

# O validador é biblioteca padrão: roda com o python3 do PATH, sem sincronizar ambiente.
python3 scripts/validar.py

# Os testes usam o ambiente do uv — o mesmo Python 3.12 e o mesmo pytest do CI.
if command -v uv >/dev/null 2>&1; then
  uv run --frozen --group ci pytest -q
elif python3 -c "import pytest" >/dev/null 2>&1; then
  python3 -m pytest -q
else
  echo "aviso: sem uv e sem pytest; rode 'uv sync --group ci' (ou instale pytest)" >&2
fi
